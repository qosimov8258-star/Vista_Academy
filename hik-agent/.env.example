# ERP manzili (API prefiksi bilan)
ERP_URL=https://vista-academy.uz/api/v1

# Qurilma agent tokeni — ERP'da qurilma qo'shilganda bir marta ko'rsatiladi.
# Bir obyektda bir nechta terminal bo'lsa — vergul bilan: AGENT_TOKENS=hik_aaa,hik_bbb
AGENT_TOKENS=

# Voqealar va buyruqlarni tekshirish oralig'i (soniya)
POLL_INTERVAL_SEC=5

# Agent holati (oxirgi sinxron vaqti) va internet uzilgandagi navbat shu papkada
DATA_DIR=./data

# Birinchi ishga tushishda qancha oldingi voqealar olinadi (soat)
INITIAL_LOOKBACK_HOURS=24

# Log darajasi: debug | info | warn | error
LOG_LEVEL=info

# --- ISAPI sozlamalari (proshivkaga qarab farq qilishi mumkin — README'dagi "probe"ga qarang) ---
# Yuz yuklash multipart qismlari nomlari
FACE_JSON_FIELD=FaceDataRecord
FACE_IMAGE_FIELD=img
# Yuz kutubxonasi
FACE_LIB_TYPE=blackFD
FACE_FDID=1
# Rasm shu hajmdan (bayt) oshmasligi kerak
FACE_MAX_BYTES=200000
# Xodim ismi uchun maksimal uzunlik (bayt). Bo'sh qoldirilsa qurilma capabilities'dan olinadi, u ham bo'lmasa 32
NAME_MAX_BYTES=
# Xodim qurilmada qachongacha amal qiladi
USER_VALID_END=2037-12-31T23:59:59
