# API manzili. Serverda va subdomen rejimida — nisbiy (/api/v1): nginx har bir
# hostda /api/v1 ni API'ga uzatadi. Lokalda API_PROXY_TARGET bilan birga.
NEXT_PUBLIC_API_URL=/api/v1
# Faqat lokalda: /api/v1 so'rovlarini shu manzildagi API'ga uzatish (next.config rewrites)
API_PROXY_TARGET=http://localhost:4000
# Bog'chalar subdomeni: <slug>.<domen>. Serverda zeeron.uz, lokalda localhost
# (usmon.localhost:3101). Bo'sh bo'lsa — eski /{slug}/... manzillar.
NEXT_PUBLIC_TENANT_BASE_DOMAIN=localhost
