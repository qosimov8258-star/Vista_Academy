DATABASE_URL="postgresql://bogcha:bogcha@localhost:5436/bogcha?schema=public"
PORT=4000
NODE_ENV=development

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_TTL_DAYS=30

JWT_TENANT_ACCESS_SECRET="change-me-tenant-access-secret"
JWT_TENANT_ACCESS_TTL="15m"
JWT_TENANT_REFRESH_TTL_DAYS=30

CORS_ORIGIN="http://localhost:3000,http://localhost:3001"
COOKIE_SECURE=false

SEED_SUPER_ADMIN_LOGIN="admin"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe123!"

# Xodim kabinet parolini shifrlash (AES-256-GCM, "Parolni ko'rsatish" funksiyasi uchun) — 64 xonali hex, 32 bayt.
# Generatsiya: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMPLOYEE_SECRET_KEY="change-me-64-char-hex-key"

# WebAuthn (parolni ko'rsatishdan oldin admin qurilmasini — Face ID/Windows Hello/PIN — tasdiqlash)
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="Vista Academy"
WEBAUTHN_ORIGIN="http://localhost:3101,http://localhost:3100"
