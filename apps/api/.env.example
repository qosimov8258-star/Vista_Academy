DATABASE_URL="postgresql://bogcha:bogcha@localhost:5436/bogcha?schema=public"
PORT=4000
NODE_ENV=development

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_TTL_DAYS=30

JWT_TENANT_ACCESS_SECRET="change-me-tenant-access-secret"
JWT_TENANT_ACCESS_TTL="15m"
JWT_TENANT_REFRESH_TTL_DAYS=30

CORS_ORIGIN="http://localhost:3000,http://localhost:3001"
COOKIE_SECURE=false

SEED_SUPER_ADMIN_LOGIN="admin"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe123!"

# Xodim kabinet parolini shifrlash (AES-256-GCM, "Parolni ko'rsatish" funksiyasi uchun) — 64 xonali hex, 32 bayt.
# Generatsiya: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMPLOYEE_SECRET_KEY="change-me-64-char-hex-key"

# WebAuthn (parolni ko'rsatishdan oldin admin qurilmasini — Face ID/Windows Hello/PIN — tasdiqlash)
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="Vista Academy"
WEBAUTHN_ORIGIN="http://localhost:3101,http://localhost:3100"

# Face ID (Hikvision) qurilmalari parolini shifrlash kaliti — 64 belgili hex (32 bayt).
# Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_SECRET_KEY=
# Filial ochilish vaqtidan necha daqiqa kechikkan kelish "Kech qoldi" hisoblanadi
FACE_ID_LATE_GRACE_MINUTES=10

# Bog'chalar subdomeni: <slug>.<TENANT_BASE_DOMAIN> (masalan babyland.zeeron.uz).
# Lokalda: localhost (babyland.localhost:3101). Bo'sh bo'lsa — subdomen rejimi o'chiq.
TENANT_BASE_DOMAIN=
# Bog'chalar passkey'i shu domenga bog'lanadi (masalan zeeron.uz); bo'sh bo'lsa WEBAUTHN_RP_ID
TENANT_WEBAUTHN_RP_ID=

# Lending sayt kontenti (jadval/taomlar/o'qituvchilar) hozircha yagona, barcha
# tashkilotlar o'rtasida umumiy — faqat shu slug'dagi tashkilot bog'cha
# panelidan uni tahrirlay oladi.
#
# "Ariza qoldirish" formasi uchun BU — faqat ZAXIRA (fallback): har bir
# bog'chaning platform panelidagi "Veb-sayt" maydoni (Organization.website)
# asosiy mexanizm — arizalar shu orqali (so'rov Origin'i) to'g'ri bog'chaga
# avtomatik bog'lanadi, bu o'zgaruvchi umuman kerak bo'lmaydi. U faqat hech
# qaysi bog'chaga "Veb-sayt" kiritilmagan bo'lsa ishlatiladi.
LANDING_ORGANIZATION_SLUG="vista-academy"

# Cloudflare R2 (S3-mos) — bolalar surati, kundalik video va h.k. shu yerda saqlanadi.
# Bo'sh qoldirilsa — eski usul (baza ichida Bytes) ishlayveradi, hech narsa buzilmaydi.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Obyekt kaliti prefiksi, oxirida / bilan (muhitlarni bitta bucket ichida ajratadi).
# Prod: zeeron/   Lokal: zeeron-dev/
R2_KEY_PREFIX=
# Hozircha kodda ishlatilmaydi — fayllar hech qachon ochiq URL orqali berilmaydi,
# faqat qisqa muddatli imzolangan havola. Kelajakda kerak bo'lishi mumkin (masalan CDN).
R2_PUBLIC_URL=
