generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Platform-level identity (Platform Super Admin / Support).
// Tenant-level users (Super Admin, Filial menejeri, Administrator, ...)
// belong to a later IAM/Tenancy module and are intentionally out of scope
// for the platform panel.
// ---------------------------------------------------------------------------

enum PlatformUserRole {
  PLATFORM_SUPER_ADMIN
  PLATFORM_SUPPORT
}

model PlatformUser {
  id           String           @id @default(uuid())
  email        String           @unique
  passwordHash String           @map("password_hash")
  fullName     String           @map("full_name")
  firstName    String?          @map("first_name")
  lastName     String?          @map("last_name")
  phone        String?          @map("phone")
  avatarUrl    String?          @map("avatar_url")
  role         PlatformUserRole @default(PLATFORM_SUPER_ADMIN)
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  refreshTokens      RefreshToken[]
  walletTransactions WalletTransaction[] @relation("WalletTransactionCreatedBy")

  @@map("platform_users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  ip         String?
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Organizations (bog'chalar tarmog'i / tenant) and branches (filiallar).
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

model Organization {
  id           String             @id @default(uuid())
  name         String
  slug         String             @unique
  contactName  String?            @map("contact_name")
  contactEmail String?            @map("contact_email")
  contactPhone String?            @map("contact_phone")
  status       OrganizationStatus @default(ACTIVE)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  branches               Branch[]
  subscription           Subscription?
  wallet                 Wallet?
  tenantUsers            TenantUser[]
  children               Child[]
  employees              Employee[]
  positions              Position[]
  subjects               Subject[]
  invoices               Invoice[]
  payments               Payment[]
  ledgerEntries          LedgerEntry[]
  dailyReports           DailyReport[]
  developmentAssessments DevelopmentAssessment[]
  leads                  Lead[]
  healthProfiles         HealthProfile[]
  vaccinations           Vaccination[]
  medicationLogs         MedicationLog[]
  guardians              Guardian[]
  notificationLogs       NotificationLog[]
  dishes                 Dish[]
  auditLogs              AuditLog[]

  @@map("organizations")
}

// ---------------------------------------------------------------------------
// Tenant-level identity (Super Admin — enum value stays NETWORK_ADMIN).
// Created automatically alongside its Organization; scoped per tenant since
// email uniqueness is only guaranteed within an organization, not globally.
// ---------------------------------------------------------------------------

enum TenantUserRole {
  NETWORK_ADMIN // "Super Admin" — tashkilot bo'ylab, faqat kuzatuvchi
  BRANCH_ADMIN // "Filial admini" — bitta filial, to'liq huquq
  FINANCE // "Moliyachi" — bitta filial, faqat Moliya va Ish haqida yozadi
  MANAGER // "Administrator" — bitta filial, kundalik ish
  TEACHER // "O'qituvchi" — faqat o'ziga biriktirilgan guruhlar
}

model TenantUser {
  id              String         @id @default(uuid())
  organizationId  String         @map("organization_id")
  branchId        String?        @map("branch_id")
  email           String
  passwordHash    String         @map("password_hash")
  // Xodim kabineti paroli "Parolni ko'rsatish" funksiyasi uchun qaytarib
  // olinadigan (AES-256-GCM) shaklda ham saqlanadi — auth esa faqat
  // `passwordHash` orqali. Faqat admin tomonidan WebAuthn bilan tasdiqlangach
  // ochiladi (`WebAuthnCredential`). Admin akkountlarida (login/parolni o'zi
  // biladi) bo'sh qoladi — faqat avtomatik generatsiya qilingan xodim
  // parollarida to'ldiriladi.
  passwordEncrypted Bytes?       @map("password_encrypted")
  fullName        String         @map("full_name")
  role            TenantUserRole @default(NETWORK_ADMIN)
  // Profil rasmi bazada saqlanadi: fayl xotirasi sozlanmagan va avatar
  // kichik (256x256 gacha siqiladi), shuning uchun alohida saqlash
  // xizmatiga bog'lanishdan ko'ra shu soddaroq va deploy'dan keyin
  // yo'qolmaydi. `avatarUpdatedAt` brauzer keshini yangilash uchun.
  avatar          Bytes?         @map("avatar")
  avatarMimeType  String?        @map("avatar_mime_type")
  avatarUpdatedAt DateTime?      @map("avatar_updated_at")
  isActive        Boolean        @default(true) @map("is_active")
  // Faol/nofaol hisoblarni ajratish uchun — muvaffaqiyatli har bir loginda yangilanadi.
  lastLoginAt     DateTime?      @map("last_login_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch            Branch?              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  refreshTokens     TenantRefreshToken[]
  recordedPayments  Payment[]
  assignedLeads     Lead[]               @relation("LeadAssignedTo")
  leadActivities    LeadActivity[]       @relation("LeadActivityCreatedBy")
  medicationLogs    MedicationLog[]
  sentNotifications NotificationLog[]    @relation("NotificationSentBy")
  employee          Employee?
  webauthnCredentials WebAuthnCredential[]
  auditLogs         AuditLog[]

  @@unique([organizationId, email])
  @@index([branchId])
  @@map("tenant_users")
}

/**
 * Admin qurilmasiga bog'langan passkey (Face ID / Windows Hello / qurilma
 * PIN kodi). Xodim parolini "ko'rsatish" tugmasi shu bilan tasdiqlanadi —
 * ro'yxatdan o'tgan qurilmasiz parol hech qachon ochilmaydi.
 */
model WebAuthnCredential {
  id           String    @id @default(uuid())
  tenantUserId String    @map("tenant_user_id")
  credentialId String    @unique @map("credential_id")
  publicKey    Bytes     @map("public_key")
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  deviceName   String?   @map("device_name")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  tenantUser TenantUser @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)

  @@index([tenantUserId])
  @@map("webauthn_credentials")
}

model TenantRefreshToken {
  id           String    @id @default(uuid())
  tenantUserId String    @map("tenant_user_id")
  tokenHash    String    @unique @map("token_hash")
  userAgent    String?   @map("user_agent")
  ip           String?
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedBy   String?   @map("replaced_by")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenantUser TenantUser @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)

  @@index([tenantUserId])
  @@map("tenant_refresh_tokens")
}

model Branch {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  name            String
  slug            String
  address         String?
  timezone        String    @default("Asia/Tashkent")
  currency        String    @default("UZS")
  // Ish vaqti ("08:00" / "19:00" shaklida) — Sozlamalarda ko'rsatish uchun,
  // hozircha hech qanday amal (masalan davomat cheklovi) ularga bog'liq emas.
  openTime            String?  @map("open_time")
  closeTime           String?  @map("close_time")
  // Yangi hisob-faktura yaratishda bo'sh qoldirilsa shu summa taklif etiladi.
  defaultTuitionAmount Decimal? @map("default_tuition_amount") @db.Decimal(12, 2)
  // Filial belgisi (logotip). TenantUser avatari bilan bir xil yondashuv:
  // rasm 256x256 gacha kichraytiriladi va bevosita bazada saqlanadi.
  // Blob har bir filial so'roviga tushib ketmasligi uchun Prisma mijozida
  // global `omit` qo'yilgan (qarang: src/database/prisma.service.ts).
  avatar          Bytes?    @map("avatar")
  avatarMimeType  String?   @map("avatar_mime_type")
  avatarUpdatedAt DateTime? @map("avatar_updated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenantUsers            TenantUser[]
  groups                 Group[]
  children               Child[]
  employees              Employee[]
  attendances            Attendance[]
  invoices               Invoice[]
  payments               Payment[]
  ledgerEntries          LedgerEntry[]
  menuEntries            MenuEntry[]
  employeeAttendances    EmployeeAttendance[]
  dailyReports           DailyReport[]
  developmentAssessments DevelopmentAssessment[]
  leads                  Lead[]
  healthProfiles         HealthProfile[]
  vaccinations           Vaccination[]
  medicationLogs         MedicationLog[]
  shifts                 Shift[]
  payrollEntries         PayrollEntry[]
  notificationLogs       NotificationLog[]
  auditLogs              AuditLog[]

  @@unique([organizationId, name])
  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Groups, children, employees, attendance and (simplified) parent billing.
// Minimal shape to power the branch dashboard KPIs; will grow into the full
// modules described in the product spec (schedules, HR, ledgered payments).
// ---------------------------------------------------------------------------

enum GroupStatus {
  ACTIVE
  INACTIVE
}

model Group {
  id        String      @id @default(uuid())
  branchId  String      @map("branch_id")
  name      String
  capacity  Int         @default(20)
  status    GroupStatus @default(ACTIVE)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  branch   Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  children Child[]
  teachers GroupTeacher[]

  @@unique([branchId, name])
  @@index([branchId])
  @@map("groups")
}

enum Gender {
  MALE
  FEMALE
}

enum ChildStatus {
  ACTIVE
  INACTIVE
  QUARANTINED
}

model Child {
  id               String      @id @default(uuid())
  organizationId   String      @map("organization_id")
  // Xodimlar va ota-onalar og'zaki ishlatadigan qisqa raqam ("id12345").
  // Tashkilot ichida unikal, UUID esa ichki identifikator bo'lib qoladi.
  publicId         Int         @map("public_id")
  branchId         String      @map("branch_id")
  groupId          String?     @map("group_id")
  firstName        String      @map("first_name")
  lastName         String      @map("last_name")
  // Familiya + ism birlashmasi. Ikki qismdan hosil qilinadi, lekin ustun
  // sifatida saqlanadi: qidiruv, eksport, hisob-faktura va davomat
  // ro'yxatlari bola nomini shu yagona maydondan oladi.
  fullName         String      @map("full_name")
  gender           Gender?
  birthDate        DateTime?   @map("birth_date")
  status           ChildStatus @default(ACTIVE)
  // Bola surati. Filial va foydalanuvchi rasmlari bilan bir xil yondashuv:
  // brauzerda kichraytirilib, bevosita bazada saqlanadi. Blob oddiy
  // so'rovlarga tushmasligi uchun Prisma mijozida global `omit` bor.
  avatar           Bytes?      @map("avatar")
  avatarMimeType   String?     @map("avatar_mime_type")
  avatarUpdatedAt  DateTime?   @map("avatar_updated_at")
  quarantineUntil  DateTime?   @map("quarantine_until") @db.Date
  quarantineReason String?     @map("quarantine_reason")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch                 Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  group                  Group?                  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  attendances            Attendance[]
  invoices               Invoice[]
  payments               Payment[]
  ledgerEntries          LedgerEntry[]
  dailyReports           DailyReport[]
  developmentAssessments DevelopmentAssessment[]
  convertedFromLead      Lead?
  healthProfile          HealthProfile?
  vaccinations           Vaccination[]
  medicationLogs         MedicationLog[]
  guardians              ChildGuardian[]
  notificationLogs       NotificationLog[]

  @@unique([organizationId, publicId])
  @@index([organizationId, branchId])
  @@index([groupId])
  @@map("children")
}

// ---------------------------------------------------------------------------
// Kundalik hisobot (daily report) & rivojlanish kuzatuvi (development tracking)
// per spec §1.8. Photo/media attachments are out of scope here — this
// environment has no object storage wired up, so a file-upload field would be
// dead weight with nothing behind it.
// ---------------------------------------------------------------------------

enum EatingQuality {
  GOOD
  AVERAGE
  POOR
}

enum MoodStatus {
  HAPPY
  NEUTRAL
  UPSET
}

model DailyReport {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  branchId       String         @map("branch_id")
  childId        String         @map("child_id")
  date           DateTime       @db.Date
  eatingQuality  EatingQuality? @map("eating_quality")
  sleepMinutes   Int?           @map("sleep_minutes")
  mood           MoodStatus?
  toiletNotes    String?        @map("toilet_notes")
  activityNotes  String?        @map("activity_notes")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, date])
  @@index([branchId, date])
  @@map("daily_reports")
}

enum DevelopmentRating {
  BELOW_EXPECTED
  ON_TRACK
  ABOVE_EXPECTED
}

model DevelopmentAssessment {
  id              String             @id @default(uuid())
  organizationId  String             @map("organization_id")
  branchId        String             @map("branch_id")
  childId         String             @map("child_id")
  period          String // "YYYY-MM"
  speechRating    DevelopmentRating? @map("speech_rating")
  motorRating     DevelopmentRating? @map("motor_rating")
  socialRating    DevelopmentRating? @map("social_rating")
  cognitiveRating DevelopmentRating? @map("cognitive_rating")
  note            String?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, period])
  @@index([branchId, period])
  @@map("development_assessments")
}

/// Guruh va tarbiyachi bog'lanishi. Ko'p-ko'pga: bitta guruhda tarbiyachi
/// va uning yordamchisi bo'lishi, bitta tarbiyachi esa bir necha guruhga
/// biriktirilishi mumkin. O'qituvchining tizimda nimani ko'rishi aynan shu
/// jadval orqali aniqlanadi.
model GroupTeacher {
  groupId    String   @map("group_id")
  employeeId String   @map("employee_id")
  createdAt  DateTime @default(now()) @map("created_at")

  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([groupId, employeeId])
  @@index([employeeId])
  @@map("group_teachers")
}

model Employee {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  branchId        String    @map("branch_id")
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  // Familiya + ism birlashmasi. Bolalardagi kabi ikki qismdan hosil qilinadi,
  // lekin ustun sifatida saqlanadi — ro'yxatlar va eksportlar shundan oladi.
  fullName        String    @map("full_name")
  phone           String?
  position        String
  // Faqat "Fan o'qituvchisi" lavozimi uchun to'ldiriladi — qaysi fanlarni
  // o'qitishini belgilaydi. Boshqa lavozimlarda bo'sh massiv.
  subjects        String[]  @default([])
  isActive        Boolean   @default(true) @map("is_active")
  // Xodim surati. Bolalar/filial/foydalanuvchi rasmlari bilan bir xil
  // yondashuv: brauzerda kichraytirilib, bevosita bazada saqlanadi.
  avatar          Bytes?    @map("avatar")
  avatarMimeType  String?   @map("avatar_mime_type")
  avatarUpdatedAt DateTime? @map("avatar_updated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Xodimning kabineti (login). Hamma xodimga ham kerak emas — oshpaz yoki
  // farrosh tizimga kirmaydi, shuning uchun bog'lanish ixtiyoriy.
  tenantUserId String? @unique @map("tenant_user_id")

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tenantUser     TenantUser?          @relation(fields: [tenantUserId], references: [id], onDelete: SetNull)
  teachingGroups GroupTeacher[]
  attendances    EmployeeAttendance[]
  salaryScheme   SalaryScheme?
  shifts         Shift[]
  payrollEntries PayrollEntry[]

  @@index([organizationId, branchId])
  @@map("employees")
}

/**
 * Tashkilot bo'ylab qayta ishlatiladigan lavozimlar katalogi. Yangi tashkilot
 * ochilganda odatiy to'plam (tarbiyachi, kassir, oshpaz va h.k.) avtomatik
 * yaratiladi; xodim qo'shishda ro'yxatda yo'q lavozim kiritilsa, shu yerga
 * qo'shilib, keyingi safar ham tanlash mumkin bo'ladi.
 */
model Position {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("positions")
}

/**
 * Tashkilot bo'ylab qayta ishlatiladigan fanlar katalogi — Position bilan
 * bir xil andoza. Yangi tashkilot ochilganda odatiy to'plam avtomatik
 * yaratiladi; "Fan o'qituvchisi" uchun fan tanlashda ro'yxatda yo'q fan
 * kiritilsa, shu yerga qo'shilib, keyingi safar ham tanlash mumkin bo'ladi.
 */
model Subject {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("subjects")
}

enum EmployeeAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  SICK
  ON_LEAVE
}

model EmployeeAttendance {
  id         String                   @id @default(uuid())
  employeeId String                   @map("employee_id")
  branchId   String                   @map("branch_id")
  date       DateTime                 @db.Date
  status     EmployeeAttendanceStatus
  // "HH:MM" shaklida — soatlik hisob-kitob kerak bo'lmagani uchun vaqt
  // oralig'i emas, oddiy matn sifatida saqlanadi.
  checkInTime  String? @map("check_in_time")
  checkOutTime String? @map("check_out_time")
  note       String?
  createdAt  DateTime                 @default(now()) @map("created_at")
  updatedAt  DateTime                 @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([branchId, date])
  @@map("employee_attendances")
}

model MenuEntry {
  id        String   @id @default(uuid())
  branchId  String   @map("branch_id")
  date      DateTime @db.Date
  breakfast String?
  lunch     String?
  snack     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, date])
  @@index([branchId, date])
  @@map("menu_entries")
}

/**
 * Taomlar katalogi — tashkilot bo'ylab qayta ishlatiladigan taom nomlari,
 * kaloriya va allergenlar bilan. Menyu kuni (`MenuEntry`) hali ham erkin
 * matn — katalog shu matnni yozishda tanlash uchun yordamchi ro'yxat,
 * ikkalasi orasida majburiy bog'lanish yo'q.
 */
model Dish {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  calories       Int?
  allergens      String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@map("dishes")
}

/**
 * Nozik amallar tarixi — kim, qachon, nimani o'zgartirgani. Hozircha
 * hisoblar (TenantUser) va moliya (to'lov/qaytarish) bo'yicha amallar
 * yoziladi; boshqa modullarga bosqichma-bosqich kengaytiriladi.
 *
 * `actorName` maqsadli ravishda ikkilangan (denormalized): `actor` (login)
 * keyinchalik o'chirilishi mumkin (masalan xodim ishdan bo'shaganda), lekin
 * tarixda kim qilgani o'qilishda qolishi kerak.
 */
model AuditLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  branchId       String?  @map("branch_id")
  actorUserId    String?  @map("actor_user_id")
  actorName      String   @map("actor_name")
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  summary        String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  actor        TenantUser?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([branchId, createdAt])
  @@map("audit_logs")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  SICK
}

model Attendance {
  id        String           @id @default(uuid())
  childId   String           @map("child_id")
  branchId  String           @map("branch_id")
  date      DateTime         @db.Date
  status    AttendanceStatus
  note      String?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  child  Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([childId, date])
  @@index([branchId, date])
  @@map("attendances")
}

// ---------------------------------------------------------------------------
// Billing (ota-ona to'lovlari): invoices and payments are separate aggregates
// per spec §1.11 — a payment can be allocated across one or more invoices via
// PaymentAllocation, and every money movement is additionally recorded as an
// append-only LedgerEntry per child (corrections happen via new entries —
// REFUND/ADJUSTMENT — never by editing or deleting a prior one).
//
// Payment gateways (Click/Payme/Uzum) from the spec are intentionally not
// wired up here: without real sandbox credentials, a "provider" adapter would
// just be dead code that nothing can ever call. PaymentMethod is structured
// so gateway methods can be added later behind the same Payment/Allocation
// model without a schema change to the parts already in use (CASH/BANK_TRANSFER).
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  branchId       String        @map("branch_id")
  childId        String        @map("child_id")
  amount         Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  currency       String        @default("UZS")
  period         String
  dueDate        DateTime      @map("due_date")
  status         InvoiceStatus @default(PENDING)
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  child         Child               @relation(fields: [childId], references: [id], onDelete: Cascade)
  allocations   PaymentAllocation[]
  ledgerEntries LedgerEntry[]

  @@index([organizationId, branchId, status])
  @@index([childId])
  @@map("invoices")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  COMPLETED
  REFUNDED
}

model Payment {
  id               String        @id @default(uuid())
  organizationId   String        @map("organization_id")
  branchId         String        @map("branch_id")
  childId          String        @map("child_id")
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("UZS")
  method           PaymentMethod @default(CASH)
  status           PaymentStatus @default(COMPLETED)
  note             String?
  recordedByUserId String?       @map("recorded_by_user_id")
  refundedAt       DateTime?     @map("refunded_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  child         Child               @relation(fields: [childId], references: [id], onDelete: Cascade)
  recordedBy    TenantUser?         @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)
  allocations   PaymentAllocation[]
  ledgerEntries LedgerEntry[]

  @@index([organizationId, branchId])
  @@index([childId])
  @@map("payments")
}

model PaymentAllocation {
  id        String   @id @default(uuid())
  paymentId String   @map("payment_id")
  invoiceId String   @map("invoice_id")
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

enum LedgerEntryType {
  CHARGE
  DISCOUNT
  PAYMENT
  REFUND
  ADJUSTMENT
}

model LedgerEntry {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  branchId       String          @map("branch_id")
  childId        String          @map("child_id")
  type           LedgerEntryType
  /// Signed: positive increases what the family owes (CHARGE, REFUND), negative decreases it (DISCOUNT, PAYMENT).
  amount         Decimal         @db.Decimal(12, 2)
  invoiceId      String?         @map("invoice_id")
  paymentId      String?         @map("payment_id")
  note           String?
  createdAt      DateTime        @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payment      Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([childId, createdAt])
  @@map("ledger_entries")
}

// ---------------------------------------------------------------------------
// Plans & subscriptions (SaaS platform billing).
// ---------------------------------------------------------------------------

model Plan {
  id           String   @id @default(uuid())
  name         String
  code         String   @unique
  priceMonthly Decimal  @map("price_monthly") @db.Decimal(14, 2)
  currency     String   @default("UZS")
  maxBranches  Int      @map("max_branches")
  maxChildren  Int      @map("max_children")
  maxEmployees Int      @map("max_employees")
  maxStorageGb Int      @map("max_storage_gb")
  features     Json     @default("{}")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  ACTIVE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
}

model Subscription {
  id                 String             @id @default(uuid())
  organizationId     String             @unique @map("organization_id")
  planId             String             @map("plan_id")
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  graceUntil         DateTime?          @map("grace_until")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([planId])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Wallet (immutable ledger) per organization.
// ---------------------------------------------------------------------------

enum WalletTransactionType {
  TOP_UP
  SUBSCRIPTION_CHARGE
  REFUND
  BONUS
  ADJUSTMENT
}

model Wallet {
  id             String   @id @default(uuid())
  organizationId String   @unique @map("organization_id")
  balance        Decimal  @default(0) @db.Decimal(14, 2)
  currency       String   @default("UZS")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id              String                @id @default(uuid())
  walletId        String                @map("wallet_id")
  type            WalletTransactionType
  amount          Decimal               @db.Decimal(14, 2)
  balanceAfter    Decimal               @map("balance_after") @db.Decimal(14, 2)
  note            String?
  createdByUserId String?               @map("created_by_user_id")
  createdAt       DateTime              @default(now()) @map("created_at")

  wallet        Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  createdByUser PlatformUser? @relation("WalletTransactionCreatedBy", fields: [createdByUserId], references: [id])

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

// ---------------------------------------------------------------------------
// CRM / Navbat (leads & waiting list) — spec §1.6. Pipeline stages and lead
// sources are a fixed, sensible set rather than the spec's "configurable per
// organization" taxonomy — a full rule-configuration UI is its own project.
// ---------------------------------------------------------------------------

enum LeadStage {
  NEW
  TRIAL_DAY_SCHEDULED
  CONTRACT
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  WALK_IN
  OTHER
}

enum AgeGroup {
  AGE_1_2
  AGE_2_3
  AGE_3_4
  AGE_4_5
  AGE_5_6
  AGE_6_7
}

model Lead {
  id               String     @id @default(uuid())
  organizationId   String     @map("organization_id")
  branchId         String     @map("branch_id")
  childFullName    String     @map("child_full_name")
  childBirthDate   DateTime?  @map("child_birth_date")
  ageGroup         AgeGroup?  @map("age_group")
  parentName       String     @map("parent_name")
  parentPhone      String     @map("parent_phone")
  source           LeadSource @default(OTHER)
  stage            LeadStage  @default(NEW)
  lostReason       String?    @map("lost_reason")
  assignedToUserId String?    @map("assigned_to_user_id")
  convertedChildId String?    @unique @map("converted_child_id")
  // Keyingi bog'lanish uchun eslatma — o'tib ketgan bo'lsa UI'da ajratib ko'rsatiladi.
  followUpDate DateTime? @map("follow_up_date") @db.Date
  // "Sinov kuni belgilandi" bosqichi uchun haqiqiy sana (avval faqat status bo'lgan).
  trialDate    DateTime? @map("trial_date") @db.Date
  // "Shartnoma" bosqichi uchun shartnoma imzolangan/imzolanadigan sana va izoh.
  contractDate DateTime? @map("contract_date") @db.Date
  contractNote String?   @map("contract_note")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assignedTo     TenantUser?    @relation("LeadAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  convertedChild Child?         @relation(fields: [convertedChildId], references: [id], onDelete: SetNull)
  activities     LeadActivity[]

  @@index([organizationId, branchId, stage])
  @@map("leads")
}

enum LeadActivityType {
  CALL
  MESSAGE
  MEETING
  TRIAL_DAY
  STAGE_CHANGE
  NOTE
}

model LeadActivity {
  id              String           @id @default(uuid())
  leadId          String           @map("lead_id")
  type            LeadActivityType
  note            String?
  createdByUserId String?          @map("created_by_user_id")
  createdAt       DateTime         @default(now()) @map("created_at")

  lead      Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy TenantUser? @relation("LeadActivityCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

// ---------------------------------------------------------------------------
// Sog'liq / Tibbiyot (health) — spec §1.9. Karantin (quarantine) is modeled
// as a Child status + reason/until fields rather than a separate history
// table, matching how the existing ChildStatus field already works.
// ---------------------------------------------------------------------------

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

model HealthProfile {
  id                String     @id @default(uuid())
  childId           String     @unique @map("child_id")
  organizationId    String     @map("organization_id")
  branchId          String     @map("branch_id")
  bloodType         BloodType? @map("blood_type")
  chronicConditions String?    @map("chronic_conditions")
  allergies         String?
  notes             String?
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("health_profiles")
}

enum VaccinationStatus {
  SCHEDULED
  DONE
  MISSED
}

model Vaccination {
  id             String            @id @default(uuid())
  childId        String            @map("child_id")
  organizationId String            @map("organization_id")
  branchId       String            @map("branch_id")
  name           String
  scheduledDate  DateTime          @map("scheduled_date") @db.Date
  doneDate       DateTime?         @map("done_date") @db.Date
  status         VaccinationStatus @default(SCHEDULED)
  note           String?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, scheduledDate])
  @@map("vaccinations")
}

model MedicationLog {
  id               String   @id @default(uuid())
  childId          String   @map("child_id")
  organizationId   String   @map("organization_id")
  branchId         String   @map("branch_id")
  medicationName   String   @map("medication_name")
  dose             String
  givenAt          DateTime @map("given_at")
  givenByUserId    String?  @map("given_by_user_id")
  parentAuthorized Boolean  @default(false) @map("parent_authorized")
  note             String?
  createdAt        DateTime @default(now()) @map("created_at")

  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  givenBy      TenantUser?  @relation(fields: [givenByUserId], references: [id], onDelete: SetNull)

  @@index([childId, givenAt])
  @@map("medication_logs")
}

// ---------------------------------------------------------------------------
// Guardian (ota-ona/vasiy) linking — spec §1.7. This is the data foundation
// for a future parent portal; no separate portal-web app is built here.
// ---------------------------------------------------------------------------

enum GuardianRelation {
  FATHER
  MOTHER
  GRANDPARENT
  OTHER
}

model Guardian {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  fullName       String   @map("full_name")
  phone          String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  children     ChildGuardian[]

  @@index([organizationId])
  @@map("guardians")
}

model ChildGuardian {
  id                      String           @id @default(uuid())
  childId                 String           @map("child_id")
  guardianId              String           @map("guardian_id")
  relation                GuardianRelation @default(OTHER)
  isPrimary               Boolean          @default(false) @map("is_primary")
  canPickup               Boolean          @default(true) @map("can_pickup")
  canViewFinance          Boolean          @default(false) @map("can_view_finance")
  canReceiveNotifications Boolean          @default(true) @map("can_receive_notifications")
  createdAt               DateTime         @default(now()) @map("created_at")

  child    Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([childId, guardianId])
  @@index([guardianId])
  @@map("child_guardians")
}

// ---------------------------------------------------------------------------
// HR / Payroll — spec §1.13. CUSTOM_FORMULA from the spec is intentionally
// omitted: it requires a safe expression DSL (explicitly not eval()), and a
// half-built "safe" evaluator would be worse than not having one.
// ---------------------------------------------------------------------------

enum SalaryRuleType {
  FIXED
  PER_HOUR
  PER_CHILD
}

model SalaryScheme {
  id          String         @id @default(uuid())
  employeeId  String         @unique @map("employee_id")
  ruleType    SalaryRuleType @default(FIXED) @map("rule_type")
  fixedAmount Decimal        @default(0) @map("fixed_amount") @db.Decimal(14, 2)
  rate        Decimal        @default(0) @db.Decimal(14, 2)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("salary_schemes")
}

model Shift {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  branchId   String   @map("branch_id")
  date       DateTime @db.Date
  hours      Decimal  @db.Decimal(5, 2)
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([branchId, date])
  @@map("shifts")
}

enum PayrollStatus {
  DRAFT
  PAID
}

model PayrollEntry {
  id            String        @id @default(uuid())
  employeeId    String        @map("employee_id")
  branchId      String        @map("branch_id")
  period        String
  baseAmount    Decimal       @default(0) @map("base_amount") @db.Decimal(14, 2)
  bonusAmount   Decimal       @default(0) @map("bonus_amount") @db.Decimal(14, 2)
  penaltyAmount Decimal       @default(0) @map("penalty_amount") @db.Decimal(14, 2)
  // Jarimadan farqli — soliq, sug'urta, avans kabi rasmiy ushlab qolish.
  deductionAmount Decimal     @default(0) @map("deduction_amount") @db.Decimal(14, 2)
  totalAmount   Decimal       @default(0) @map("total_amount") @db.Decimal(14, 2)
  status        PayrollStatus @default(DRAFT)
  paidAt        DateTime?     @map("paid_at")
  note          String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([employeeId, period])
  @@index([branchId, period])
  @@map("payroll_entries")
}

// ---------------------------------------------------------------------------
// Bildirishnomalar (notifications) — spec §1.14. No SMS/Telegram/Email
// gateway is configured in this environment, so this is a communications
// LOG staff use to track what should go out and mark it sent once they've
// actually dispatched it themselves — not an automatic dispatcher. The
// channel/status shape matches what a real provider integration would plug
// into later without a schema change.
// ---------------------------------------------------------------------------

enum NotificationEventType {
  CHILD_ABSENT
  DAILY_REPORT_READY
  PAYMENT_DUE
  PAYMENT_OVERDUE
  VACCINATION_DUE
  QUARANTINE_ALERT
  LEAD_FOLLOW_UP
  CUSTOM
}

enum NotificationChannel {
  SMS
  TELEGRAM
  EMAIL
  PHONE_CALL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
}

model NotificationLog {
  id               String                @id @default(uuid())
  organizationId   String                @map("organization_id")
  branchId         String                @map("branch_id")
  childId          String?               @map("child_id")
  eventType        NotificationEventType @map("event_type")
  channel          NotificationChannel?
  recipientName    String                @map("recipient_name")
  recipientContact String?               @map("recipient_contact")
  message          String
  status           NotificationStatus    @default(PENDING)
  sentByUserId     String?               @map("sent_by_user_id")
  sentAt           DateTime?             @map("sent_at")
  createdAt        DateTime              @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  child        Child?       @relation(fields: [childId], references: [id], onDelete: Cascade)
  sentBy       TenantUser?  @relation("NotificationSentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@index([branchId, status, createdAt])
  @@map("notification_logs")
}
